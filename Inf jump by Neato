local P=game:GetService("Players").LocalPlayer
local U=game:GetService("UserInputService")
local G=Instance.new("ScreenGui",P:WaitForChild("PlayerGui"))
G.Name="InfiniteJumpGUI"
G.ResetOnSpawn=false

local F=Instance.new("Frame",G)
F.Size=UDim2.fromOffset(240,160)
F.Position=UDim2.new(.5,-120,.5,-80)
F.BackgroundColor3=Color3.fromRGB(20,20,25)
Instance.new("UICorner",F).CornerRadius=UDim.new(0,15)

local T=Instance.new("TextLabel",F)
T.Size=UDim2.new(1,-50,0,30)
T.Position=UDim2.fromOffset(10,3)
T.BackgroundTransparency=1
T.Text="⚡ INFINITE JUMP"
T.TextColor3=Color3.new(1,1,1)
T.TextSize=18
T.Font=Enum.Font.GothamBold

local N=Instance.new("TextLabel",F)
N.Size=UDim2.new(1,0,0,25)
N.Position=UDim2.fromOffset(0,35)
N.BackgroundTransparency=1
N.Text="BY NEATO"
N.TextSize=16
N.Font=Enum.Font.GothamBlack
N.TextColor3=Color3.fromRGB(255,255,255)
N.TextStrokeColor3=Color3.fromRGB(0,0,0)
N.TextStrokeTransparency=0

local C=Instance.new("UIGradient",N)
C.Color=ColorSequence.new({
	ColorSequenceKeypoint.new(0,Color3.fromRGB(255,0,0)),
	ColorSequenceKeypoint.new(.2,Color3.fromRGB(255,255,0)),
	ColorSequenceKeypoint.new(.4,Color3.fromRGB(0,255,0)),
	ColorSequenceKeypoint.new(.6,Color3.fromRGB(0,255,255)),
	ColorSequenceKeypoint.new(.8,Color3.fromRGB(0,100,255)),
	ColorSequenceKeypoint.new(1,Color3.fromRGB(255,0,255))
})

local X=Instance.new("TextButton",F)
X.Size=UDim2.fromOffset(35,35)
X.Position=UDim2.new(1,-42,0,7)
X.BackgroundColor3=Color3.fromRGB(200,50,50)
X.Text="X"
X.TextColor3=Color3.new(1,1,1)
X.TextSize=18
X.Font=Enum.Font.GothamBold
Instance.new("UICorner",X).CornerRadius=UDim.new(1,0)

local B=Instance.new("TextButton",F)
B.Size=UDim2.fromOffset(200,55)
B.Position=UDim2.new(.5,-100,0,70)
B.BackgroundColor3=Color3.fromRGB(170,45,45)
B.Text="INFINITE JUMP : OFF"
B.TextColor3=Color3.new(1,1,1)
B.TextSize=16
B.Font=Enum.Font.GothamBold
Instance.new("UICorner",B).CornerRadius=UDim.new(0,12)

local O=Instance.new("TextButton",G)
O.Size=UDim2.fromOffset(55,55)
O.Position=UDim2.new(0,15,.5,-27)
O.BackgroundColor3=Color3.fromRGB(25,25,30)
O.Text="☰"
O.TextColor3=Color3.new(1,1,1)
O.TextSize=25
O.Font=Enum.Font.GothamBold
O.Visible=false
Instance.new("UICorner",O).CornerRadius=UDim.new(1,0)

local on=false

B.Activated:Connect(function()
	on=not on
	B.Text="INFINITE JUMP : "..(on and "ON" or "OFF")
	B.BackgroundColor3=on and Color3.fromRGB(45,180,90) or Color3.fromRGB(170,45,45)
end)

X.Activated:Connect(function()
	F.Visible=false
	O.Visible=true
end)

O.Activated:Connect(function()
	F.Visible=true
	O.Visible=false
end)

U.JumpRequest:Connect(function()
	if on then
		local H=P.Character and P.Character:FindFirstChildOfClass("Humanoid")
		if H then H:ChangeState(Enum.HumanoidStateType.Jumping) end
	end
end)
