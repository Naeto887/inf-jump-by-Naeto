--==================================================
-- FUNCTION
--==================================================

local function GetRarityIndex(rarity)
	for i, v in ipairs(Rarities) do
		if v == rarity then
			return i
		end
	end

	return nil
end

--==================================================
-- AUTO BUY LOGIC
--==================================================
-- ระบบนี้เป็นโครงสำหรับเชื่อมกับระบบ Spawn Case
-- ต้องเชื่อมกับระบบซื้อของเกมจริงของคุณ

local function ShouldBuy(rarity)

	local selectedIndex = GetRarityIndex(SelectedRarity)
	local caseIndex = GetRarityIndex(rarity)

	if not selectedIndex or not caseIndex then
		return false
	end

	-- ซื้อระดับที่เลือกและระดับที่สูงกว่าจนถึง Void
	return caseIndex >= selectedIndex
end

-- ตัวอย่าง:
print("เลือก:", SelectedRarity)
print("Epic:", ShouldBuy("Epic"))
print("Void:", ShouldBuy("Void"))
