--========================
-- CASE CHECK
--========================

local function GetRarityIndex(Rarity)

    for i,v in ipairs(Rarities) do
        if v == Rarity then
            return i
        end
    end

    return nil
end

local function ShouldBuy(Rarity)

    local SelectedIndex = GetRarityIndex(SelectedRarity)
    local CaseIndex = GetRarityIndex(Rarity)

    if not SelectedIndex or not CaseIndex then
        return false
    end

    -- Azure = ซื้อ Azure + Void
    -- Void = ซื้อ Void เท่านั้น
    return CaseIndex >= SelectedIndex
end

--========================
-- AUTO SPAWN
--========================

task.spawn(function()

    while task.wait(1) do

        if AutoSpawnCase then

            if SpawnCase then
                SpawnCase:FireServer()
            else
                warn("Naeto: ไม่พบ RemoteEvent 'SpawnCase'")
            end

        end

    end

end)

--========================
-- AUTO BUY
--========================

task.spawn(function()

    while task.wait(0.3) do

        if AutoBuy then

            for CaseName,Data in pairs(Cases) do

                if ShouldBuy(Data.Rarity) then

                    local CaseObject = workspace:FindFirstChild(CaseName,true)

                    if CaseObject and BuyCase then

                        BuyCase:FireServer(CaseObject)

                    end

                end

            end

        end

    end

end)

